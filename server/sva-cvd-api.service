[Unit]
Description=SVA Iran Assets CVD API Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sva_iran_assets/server
ExecStart=/usr/bin/python3 /opt/sva_iran_assets/server/api_server.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
